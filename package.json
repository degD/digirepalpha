{
  "name": "digirepalpha",
  "version": "0.12",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "serve:export": "serve out --listen 3001",
    "lint": "eslint",
    "test": "bun test lib/tests",
    "test:e2e": "playwright test",
    "android:sync": "bun run build && cap sync android",
    "android:run": "bun run android:sync && cap run android",
    "android:open": "cap open android",
    "android:apk": "bun run android:sync && ./android/gradlew -p android assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8",
    "@capacitor/core": "^8",
    "@capacitor/filesystem": "^8",
    "@capacitor/share": "^8",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@capacitor/assets": "^3",
    "@capacitor/cli": "^8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "serve": "^14",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
